@using UseNotesApplication.ViewModels.Notes
@model TaskEditViewModel
@{
    ViewData["Title"] = "Create Notes";
}
@if (TempData["NotesCreateErro"] != null)
{
    <div class="alert alert-danger">@TempData["NotesCreateError"]</div>
}
<h2>Create New Note</h2>

<form asp-action="CreateNote" method="post">
    <div class="form-Group">
        <label asp-for="Title"></label>
        <input asp-for="Title" class="form-control"/>
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class=" form-group">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    </div>
    <div class="form-group">
        <label asp-for="Status">Status</label>
        <select asp-for="Status" class="form-control">
            <option>Pending</option>
            <option>In Progress</option>
            <option>Completed</option>
        </select>
    </div>
    <button type="submit" class="btn btn mt-3">Create Note</button>
    <a asp-action="Index" class="btn btn-secondary mt-3">Cancel</a>
</form>